---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import ColourKeyboard from '../components/ColourKeyboard.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { SCRIABIN_COLOURS } from '../utils/scriabin';

const latest = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.eyebrow {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.8em;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.latest {
				padding: 0;
				list-style: none;
			}
			.latest li {
				display: flex;
				gap: 0.75rem;
				align-items: baseline;
				margin-bottom: 0.5rem;
			}
			.dot {
				flex: 0 0 auto;
				width: 0.8em;
				height: 0.8em;
				border-radius: 50%;
				background: var(--key-colour);
			}
			.latest time {
				color: rgb(var(--gray));
				font-size: 0.8em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">A Scriabin piano journal</p>
			<h1>Mysterium</h1>
			<p>
				Alexander Scriabin heard keys as colours: C was red, D yellow, F♯ a brilliant blue.
				In <em>Prometheus</em> he even wrote a part for a keyboard of light. This site is my practice
				journal for his piano music, with an instrument you can play in his colours.
			</p>

			<ColourKeyboard />

			<h2>From the journal</h2>
			<ul class="latest">
				{
					latest.map((post) => (
						<li>
							<span
								class="dot"
								style={`--key-colour: ${post.data.key ? SCRIABIN_COLOURS[post.data.key].hex : 'var(--accent)'}`}
							/>
							<span>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								<br />
								<FormattedDate date={post.data.pubDate} />
							</span>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
