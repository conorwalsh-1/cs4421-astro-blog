---
export const prerender = true;

import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import ColourKeyboard from '../../components/ColourKeyboard.astro';
import ComposerDemo from '../../components/ComposerDemo.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const composers = (await getCollection('composers')).sort((a, b) => a.data.order - b.data.order);
	return composers.map((composer, i) => ({
		params: { slug: composer.id },
		props: { composer, previous: composers[i - 1], next: composers[i + 1] },
	}));
}

interface Props {
	composer: CollectionEntry<'composers'>;
	previous?: CollectionEntry<'composers'>;
	next?: CollectionEntry<'composers'>;
}

const { composer, previous, next } = Astro.props;
const { data } = composer;
const { Content } = await render(composer);
const posts = (await getCollection('blog', (post) => post.data.composer?.id === composer.id)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const lifespan = data.died ? `${data.born}–${data.died}` : `Born ${data.born}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${data.name} | ${SITE_TITLE}`} description={data.tagline} />
		<style>
			main {
				width: 960px;
			}
			.hero {
				padding: 1.5rem 0 0.5rem;
			}
			.hero h1 {
				margin: 0.15rem 0 0.3rem;
			}
			.meta {
				margin: 0;
				color: rgb(var(--gray));
				font-style: italic;
			}
			.tagline {
				max-width: 44rem;
				margin: 1rem 0 0;
				color: rgb(var(--black));
				font-family: var(--font-display);
				font-size: 1.45em;
				font-style: italic;
				line-height: 1.35;
			}
			.use-theme {
				margin-top: 1.2rem;
				padding: 0.35em 1em;
				border: 1px solid var(--accent);
				border-radius: 4px;
				background: transparent;
				color: var(--accent);
				font: inherit;
				font-size: 0.8em;
				cursor: pointer;
			}
			.use-theme:hover,
			.use-theme:focus-visible {
				background: var(--accent);
				color: var(--on-accent);
			}
			.layout {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 18rem;
				gap: 3rem;
				margin-top: 2.5rem;
			}
			aside section {
				margin-bottom: 2rem;
			}
			/* Sidebar headings set as small-capital programme labels. */
			aside h2 {
				margin: 0 0 0.6rem;
				padding-bottom: 0.3rem;
				border-bottom: 1px solid var(--rule);
				color: var(--accent);
				font-family: var(--font-text);
				font-size: 0.85em;
				font-variant-caps: all-small-caps;
				letter-spacing: 0.14em;
			}
			aside ul,
			aside ol {
				margin: 0;
				padding-left: 1.1rem;
				font-size: 0.85em;
				line-height: 1.5;
			}
			aside li {
				margin-bottom: 0.45rem;
			}
			/* Works listed like a concert programme: title, dotted leader, year. */
			aside .works {
				padding: 0;
				list-style: none;
			}
			.works li {
				display: flex;
				gap: 0.4rem;
				align-items: baseline;
			}
			.work-title {
				flex: 0 1 auto;
			}
			.work-note {
				display: block;
				color: rgb(var(--gray));
				font-size: 0.9em;
				font-style: italic;
			}
			.leader {
				flex: 1 0 1rem;
				border-bottom: 1px dotted rgb(var(--gray));
				transform: translateY(-0.25em);
			}
			.year {
				flex: 0 0 auto;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			.instrument {
				margin: 0;
				font-size: 0.85em;
				font-style: italic;
				line-height: 1.5;
			}
			.post-date {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.pager {
				display: flex;
				gap: 1rem;
				justify-content: space-between;
				margin-top: 3rem;
				padding-top: 1.5rem;
				border-top: 3px double var(--rule);
			}
			.pager a {
				display: grid;
				font-family: var(--font-display);
				font-size: 1.25em;
				font-weight: 600;
				text-decoration: none;
			}
			.pager a:hover {
				text-decoration: underline;
			}
			.pager .next {
				margin-left: auto;
				text-align: right;
			}
			.pager small {
				color: rgb(var(--gray));
				font-family: var(--font-text);
				font-size: 0.6em;
				font-variant-caps: all-small-caps;
				font-weight: 600;
				letter-spacing: 0.12em;
			}
			@media (max-width: 760px) {
				.layout {
					grid-template-columns: 1fr;
					gap: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article data-palette={data.palette} data-demo-scope>
				<header class="hero">
					<p class="eyebrow">{data.era}</p>
					<h1>{data.name}</h1>
					<p class="meta">{lifespan} · {data.birthplace}</p>
					<p class="tagline">{data.tagline}</p>
					<button type="button" class="use-theme" data-use-palette={data.palette}>
						Use the {data.shortName} theme on the whole site
					</button>
				</header>

				<ComposerDemo composer={composer.id} />
				<ColourKeyboard palette={data.palette} label={`${data.shortName} colour keyboard`} />

				<div class="layout">
					<div class="prose drop-cap">
						<Content />
					</div>
					<aside>
						<section>
							<h2>Signature piano works</h2>
							<ol class="works">
								{
									data.works.map((work) => (
										<li>
											<span class="work-title">
												{work.title}
												{work.note && <span class="work-note">{work.note}</span>}
											</span>
											{work.year && (
												<>
													<span class="leader" aria-hidden="true" />
													<span class="year">{work.year}</span>
												</>
											)}
										</li>
									))
								}
							</ol>
						</section>
						<section>
							<h2>Listen for</h2>
							<ul>{data.listenFor.map((item) => <li>{item}</li>)}</ul>
						</section>
						<section>
							<h2>At the keyboard</h2>
							<p class="instrument">{data.instrument}</p>
						</section>
						{
							posts.length > 0 && (
								<section>
									<h2>From the journal</h2>
									<ul>
										{posts.map((post) => (
											<li>
												<a href={`/blog/${post.id}/`}>{post.data.title}</a>
												<br />
												<small class="post-date">
													<FormattedDate date={post.data.pubDate} />
												</small>
											</li>
										))}
									</ul>
								</section>
							)
						}
					</aside>
				</div>
			</article>

			<nav class="pager" aria-label="Other composers">
				{
					previous && (
						<a href={`/composers/${previous.id}/`} rel="prev">
							<small>← Earlier</small>
							{previous.data.name}
						</a>
					)
				}
				{
					next && (
						<a class="next" href={`/composers/${next.id}/`} rel="next">
							<small>Later →</small>
							{next.data.name}
						</a>
					)
				}
			</nav>
		</main>
		<Footer />
	</body>
</html>

<script>
	import { isPaletteId, PALETTES } from '../../utils/palettes';

	// "Use this theme" applies the composer's palette site-wide, like the header picker.
	document.querySelectorAll<HTMLButtonElement>('[data-use-palette]').forEach((button) => {
		button.addEventListener('click', () => {
			const id = button.dataset.usePalette;
			if (!isPaletteId(id)) return;
			const picker = document.querySelector<HTMLSelectElement>('[data-palette-select]');
			if (picker) {
				picker.value = id;
				picker.dispatchEvent(new Event('change'));
			}
			button.textContent = `Using the ${PALETTES[id].label} theme`;
		});
	});
</script>
