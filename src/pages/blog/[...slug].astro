---
// Prerendered at build time so the same page is served from S3/CloudFront and the container.
export const prerender = true;

import { type CollectionEntry, getCollection, getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const author = await getEntry(post.data.author);
const composer = post.data.composer ? await getEntry(post.data.composer) : undefined;
const { Content } = await render(post);
---

<BlogPost {...post.data} author={author.data} composer={composer}>
	<Content />
</BlogPost>
