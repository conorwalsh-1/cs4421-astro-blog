---
// Prerendered at build time so the same page is served from S3/CloudFront and the container.
export const prerender = true;

import { getCollection, getEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { SCRIABIN_COLOURS } from '../../utils/scriabin';

const posts = await Promise.all(
	(await getCollection('blog'))
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
		.map(async (post) => ({
			post,
			composer: post.data.composer ? await getEntry(post.data.composer) : undefined,
		})),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Journal | ${SITE_TITLE}`}
			description="Programme notes, listening guides and practice diaries about the piano repertoire."
		/>
		<style>
			.entries {
				margin: 2rem 0 0;
				padding: 0;
				list-style: none;
			}
			/* Each post set like an entry in a concert programme. */
			.entry {
				display: grid;
				grid-template-columns: 1.6rem 1fr;
				gap: 0 1rem;
				padding: 1.4rem 0;
				border-bottom: 1px solid var(--rule);
			}
			.key {
				width: 1rem;
				height: 1rem;
				margin-top: 0.55rem;
				background: var(--key-colour, var(--accent));
				transform: rotate(45deg);
			}
			.meta {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.85em;
				font-variant-caps: all-small-caps;
				letter-spacing: 0.08em;
			}
			.entry h2 {
				margin: 0.1rem 0 0.3rem;
				font-size: 1.7em;
			}
			.entry h2 a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.entry h2 a:hover {
				color: var(--accent);
			}
			.description {
				margin: 0;
				font-style: italic;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">Programme notes</p>
			<h1>Journal</h1>
			<p>Listening guides, background and practice diaries from the piano repertoire.</p>

			<ol class="entries">
				{
					posts.map(({ post, composer }) => (
						<li class="entry" data-palette={composer?.data.palette}>
							<span
								class="key"
								aria-hidden="true"
								style={post.data.key ? `--key-colour: ${SCRIABIN_COLOURS[post.data.key].hex}` : undefined}
							/>
							<div>
								<p class="meta">
									<FormattedDate date={post.data.pubDate} />
									{composer && <> · {composer.data.shortName}</>}
								</p>
								<h2>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h2>
								<p class="description">{post.data.description}</p>
							</div>
						</li>
					))
				}
			</ol>
		</main>
		<Footer />
	</body>
</html>
