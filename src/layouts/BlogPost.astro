---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import AuthorBio from '../components/AuthorBio.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SCRIABIN_COLOURS } from '../utils/scriabin';

type Props = Omit<CollectionEntry<'blog'>['data'], 'author' | 'composer'> & {
	author?: CollectionEntry<'authors'>['data'];
	/** The composer the page is about; the page takes on their colour palette. */
	composer?: CollectionEntry<'composers'>;
};

const { title, description, pubDate, updatedDate, heroImage, author, key, composer } = Astro.props;
const keyColour = key ? SCRIABIN_COLOURS[key] : undefined;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 4px;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				padding: 1.5em 0 0;
				text-align: center;
			}
			.title h1 {
				margin: 0.2em 0 0.3em;
				font-size: 3em;
				line-height: 1.08;
			}
			.date {
				color: var(--accent);
				font-size: 0.9em;
				font-variant-caps: all-small-caps;
				font-weight: 600;
				letter-spacing: 0.14em;
			}
			/* The post's key, shown as a band of its colour fading into the paper. */
			.key-banner {
				height: 6px;
				max-width: 720px;
				margin: 1.5rem auto 0;
				border-radius: 3px;
				background: linear-gradient(90deg, transparent, var(--key-colour), transparent);
			}
			.key-label {
				margin: 0.2em 0 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
				font-style: italic;
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article data-palette={composer?.data.palette}>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
					{!heroImage && keyColour && <div class="key-banner" style={`--key-colour: ${keyColour.hex}`} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{key && keyColour && <p class="key-label">In {key.replace('#', '♯')}: {keyColour.name}</p>}
						{
							composer && (
								<p class="key-label">
									About <a href={`/composers/${composer.id}/`}>{composer.data.name}</a>
								</p>
							)
						}
						<hr />
					</div>
					<div class="drop-cap">
						<slot />
					</div>
					{author && <AuthorBio {...author} />}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
