---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="ornament" aria-hidden="true"></div>
	<!-- "Fine" (Italian, "end") marks where a piece of music finishes. -->
	<p class="fine" lang="it">Fine</p>
	<p>
		&copy; {today.getFullYear()} Conor Walsh · {SITE_TITLE}: classical piano over the ages, from Bach to Hamelin.
	</p>
	<p class="links">
		<a href="/rss.xml">RSS</a>
		<a href="https://github.com/conorwalsh-1/cs4421-astro-blog" target="_blank" rel="noopener">Source on GitHub</a>
	</p>
</footer>
<style>
	footer {
		max-width: 720px;
		margin: 0 auto;
		padding: 1em 1em 4em;
		color: rgb(var(--gray));
		font-size: 0.85em;
		text-align: center;
	}
	.ornament {
		margin-top: 1em;
	}
	.fine {
		margin: 0 0 0.5em;
		color: rgb(var(--black));
		font-family: var(--font-display);
		font-size: 1.6em;
		font-style: italic;
		font-weight: 600;
	}
	p {
		margin: 0.4em 0;
	}
	.links {
		display: flex;
		justify-content: center;
		gap: 1.5em;
		font-variant-caps: all-small-caps;
		letter-spacing: 0.1em;
	}
	.links a {
		color: rgb(var(--gray));
	}
	.links a:hover {
		color: var(--accent);
	}
</style>
