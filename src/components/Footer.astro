---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Conor Walsh. Classical piano over the ages, from Bach to Hamelin.
	<div class="social-links">
		<a href="https://github.com/conorwalsh-1/cs4421-astro-blog" target="_blank">Source on GitHub</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		background-color: var(--page-bg);
		color: rgb(var(--gray));
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
</style>
