---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'authors'>['data'];

const { name, bio, avatar, links } = Astro.props;
---

<section class="author-bio" aria-labelledby="author-heading">
	<div class="author-avatar">
		<Image src={avatar} alt={`Portrait of ${name}`} width={112} height={112} />
	</div>
	<div class="author-details">
		<p class="author-label" id="author-heading">Written by</p>
		<h2>{name}</h2>
		<p>{bio}</p>
		{links.length > 0 && (
			<nav aria-label={`${name}'s social links`}>
				<ul class="author-links">
					{links.map((link) => (
						<li><a href={link.url} rel="me">{link.label}</a></li>
					))}
				</ul>
			</nav>
		)}
	</div>
</section>

<style>
	.author-bio {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.author-avatar img {
		width: 112px;
		height: 112px;
		object-fit: cover;
		border-radius: 50%;
	}
	.author-details {
		flex: 1;
	}
	.author-label {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.author-details h2 {
		margin: 0.15rem 0 0.35rem;
		font-size: 1.5em;
	}
	.author-details > p:not(.author-label) {
		margin: 0 0 0.75rem;
	}
	.author-links {
		display: flex;
		gap: 1rem;
		padding: 0;
		margin: 0;
		list-style: none;
		font-size: 0.9em;
	}
	@media (max-width: 520px) {
		.author-bio {
			gap: 1rem;
		}
		.author-avatar img {
			width: 80px;
			height: 80px;
		}
	}
</style>
