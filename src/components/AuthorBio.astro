---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'authors'>['data'];

const { name, bio, avatar, links } = Astro.props;
// Without a portrait, show the author's initials as an engraved-style monogram.
const initials = name
	.split(/\s+/)
	.map((part) => part[0])
	.join('')
	.slice(0, 3)
	.toUpperCase();
---

<section class="author-bio" aria-labelledby="author-heading">
	<div class="author-avatar">
		{
			avatar ? (
				<Image src={avatar} alt={`Portrait of ${name}`} width={96} height={96} />
			) : (
				<span class="monogram" aria-hidden="true">
					{initials}
				</span>
			)
		}
	</div>
	<div class="author-details">
		<p class="eyebrow" id="author-heading">Written by</p>
		<h2>{name}</h2>
		<p>{bio}</p>
		{
			links.length > 0 && (
				<nav aria-label={`${name}'s social links`}>
					<ul class="author-links">
						{links.map((link) => (
							<li>
								<a href={link.url} rel="me">
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}
	</div>
</section>

<style>
	.author-bio {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 3px double var(--rule);
	}
	.author-avatar img,
	.monogram {
		width: 96px;
		height: 96px;
		border-radius: 50%;
	}
	.author-avatar img {
		object-fit: cover;
	}
	.monogram {
		display: grid;
		place-items: center;
		border: 1px solid var(--accent);
		box-shadow: inset 0 0 0 4px var(--surface), inset 0 0 0 5px var(--accent);
		background: var(--surface);
		color: var(--accent);
		font-family: var(--font-display);
		font-size: 2.1em;
		font-style: italic;
		font-weight: 600;
	}
	.author-details {
		flex: 1;
	}
	.author-details h2 {
		margin: 0.1rem 0 0.35rem;
		font-size: 1.6em;
	}
	.author-details > p:not(.eyebrow) {
		margin: 0 0 0.75rem;
		font-style: italic;
	}
	.author-links {
		display: flex;
		gap: 1rem;
		padding: 0;
		margin: 0;
		list-style: none;
		font-size: 0.9em;
	}
	@media (max-width: 520px) {
		.author-bio {
			gap: 1rem;
		}
		.author-avatar img,
		.monogram {
			width: 72px;
			height: 72px;
		}
		.monogram {
			font-size: 1.6em;
		}
	}
</style>
